# === IDA Place backend - variables d'environnement ===
# Copier en .env et adapter. Toutes les intégrations externes sont optionnelles
# en développement : en leur absence l'application démarre en MODE DÉGRADÉ
# explicite (voir README.md § Mode dégradé) ; aucune donnée sensible n'est
# jamais exposée pour compenser l'absence d'un service.

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# --- PostgreSQL (MikroORM) ---
# Si injoignable au démarrage, l'API démarre quand même (connect différé) ;
# les services basculent sur un repository mémoire de secours (seed déterministe).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ida_place
DB_USER=ida_place
DB_PASSWORD=ida_place
DB_RUN_MIGRATIONS_ON_BOOT=false

# --- Redis (cache / sessions / files d'événements) ---
# Absent en dev => cache no-op en mémoire process (voir common/cache).
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# --- Keycloak (OIDC) ---
# AUTH_PROVIDER=keycloak active le KeycloakStrategy (non implémenté dans cet
# environnement de dev - cf TODO). AUTH_PROVIDER=dev active le DevAuthProvider
# qui lit l'en-tête x-dev-user (voir auth/strategies/dev-auth.provider.ts).
AUTH_PROVIDER=dev
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=ida-place
KEYCLOAK_CLIENT_ID=ida-place-api
KEYCLOAK_CLIENT_SECRET=changeme
# Secret utilisé UNIQUEMENT par le DevAuthProvider pour signer/vérifier les
# jetons de développement locaux (jamais utilisé en production).
DEV_JWT_SECRET=dev-local-only-secret-change-me

# --- Stockage documentaire (S3 / MinIO) ---
# Si injoignable, DocumentsModule bascule sur un stockage disque local
# chiffré de façon simplifiée (mode dégradé, voir documents/providers).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ida-place-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENABLED=false
LOCAL_STORAGE_DIR=./.data/documents

# --- Paperless (GED / OCR) ---
PAPERLESS_BASE_URL=http://localhost:8010
PAPERLESS_TOKEN=changeme
PAPERLESS_ENABLED=false

# --- CORS (frontend) ---
CORS_ORIGIN=http://localhost:3000

# === IDA Place backend - variables d'environnement (DÉVELOPPEMENT) ===
# Copier en .env et adapter. Pour la production, partir de
# .env.production.example (aucun mode de développement, aucun secret par défaut).
# La configuration est validée au démarrage (src/common/config/env.validation.ts) :
# une valeur dangereuse ou manquante fait échouer le démarrage avec la liste
# complète des problèmes.
#
# Toutes les intégrations externes sont optionnelles en DÉVELOPPEMENT : en leur
# absence l'application démarre en MODE DÉGRADÉ explicite (voir README.md §
# Mode dégradé). Le repli mémoire ne se déclenche que sur une erreur de
# CONNEXION à la base, et jamais en production (503).

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# --- PostgreSQL (MikroORM) ---
# Si injoignable, l'API démarre quand même (connexion différée) ; hors
# production, les services basculent sur un repository mémoire de secours.
# Les migrations ne sont jamais lancées au démarrage de l'API : `npm run migration:up`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ida_place
DB_USER=ida_place
DB_PASSWORD=ida_place
# TLS PostgreSQL (défaut : false en développement, true en production).
DB_SSL=false
# DB_SSL_CA=/chemin/vers/ca.pem   (ou certificat PEM en ligne)
# DB_SSL_REJECT_UNAUTHORIZED=true
# Journalisation des requêtes SQL ET de leurs paramètres (données personnelles) :
# uniquement en développement, sur demande explicite.
DB_DEBUG=false

# --- Redis (cache) ---
# Absent en dev => cache no-op (voir common/cache). Mot de passe et TLS dans
# l'URL : redis://:motdepasse@hôte:6379 ou rediss://:motdepasse@hôte:6380
# Mot de passe de développement aligné sur docker-compose.yml (REDIS_PASSWORD).
REDIS_URL=redis://:dev-local-redis-change-me@localhost:6379
REDIS_ENABLED=false

# --- Authentification ---
# AUTH_PROVIDER doit valoir EXPLICITEMENT "dev" ou "keycloak".
#  - keycloak : KeycloakStrategy (OIDC, jeton Bearer vérifié par JWKS) — seule
#    valeur acceptée en production ;
#  - dev : DevAuthProvider (en-tête x-dev-user, ou jeton signé par
#    DEV_JWT_SECRET) — développement uniquement, refusé si NODE_ENV=production.
AUTH_PROVIDER=dev
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=ida-place
KEYCLOAK_CLIENT_ID=ida-place-api
# Clients OIDC dont les jetons sont acceptés (azp/aud), séparés par des virgules.
# Défaut : KEYCLOAK_CLIENT_ID seul.
KEYCLOAK_ALLOWED_CLIENTS=ida-place-web,ida-place-api
# Secret de signature des jetons du DevAuthProvider. OBLIGATOIRE quand
# AUTH_PROVIDER=dev, 32 caractères minimum, PROPRE À CHAQUE POSTE : aucune
# valeur par défaut n'est acceptée. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DEV_JWT_SECRET=<à générer>

# --- Journal scellé (HMAC) ---
# Clé HMAC des empreintes du journal (hors base). Obligatoire en production.
# En développement : si absente, clé éphémère par processus (les entrées
# persistées en base ne sont alors plus vérifiables après redémarrage).
# Générer avec la même commande que DEV_JWT_SECRET.
# LEDGER_HMAC_KEY=<à générer>

# --- Stockage documentaire (S3 / MinIO) ---
# S3_ENABLED=false : stockage disque local (développement uniquement, pièces
# servies par la route authentifiée GET /documents/:id/download). En
# production, S3 est obligatoire (démarrage refusé sinon) et signe lui-même
# ses URL de téléchargement : il n'existe aucun secret de signature applicatif.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ida-place-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENABLED=false
# Chiffrement côté serveur demandé à chaque dépôt : AES256 (défaut), aws:kms,
# ou none (hors production seulement : MinIO de développement sans KMS).
S3_SSE=none
# Clé KMS (si S3_SSE=aws:kms ; sinon clé par défaut du bucket).
# S3_SSE_KMS_KEY_ID=
LOCAL_STORAGE_DIR=./.data/documents
# Antivirus des pièces : disabled (défaut) ou clamd (démon ClamAV, protocole
# INSTREAM). Si activé, un démon injoignable fait REFUSER le dépôt (503).
ANTIVIRUS_MODE=disabled
# CLAMD_HOST=localhost
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=15000

# --- Experts : chiffrement des RIB (AES-256-GCM) ---
# 32 octets en base64 (ou 64 caractères hexadécimaux), PROPRE À CHAQUE POSTE.
# Absente : la saisie d'un RIB est refusée (jamais stocké en clair). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# EXPERT_RIB_KEY=<à générer>

# --- Imports de déclarations et analyses (bornes mémoire / CPU) ---
# Lignes de données maximales par fichier importé.
IMPORT_MAX_ROWS=5000
# XLSX : taille décompressée cumulée maximale (octets, 50 Mo), ratio de
# compression maximal par entrée et nombre d'entrées de l'archive (bombe zip).
IMPORT_XLSX_MAX_UNCOMPRESSED_BYTES=52428800
IMPORT_XLSX_MAX_COMPRESSION_RATIO=100
IMPORT_XLSX_MAX_ENTRIES=500
# Nombre maximal de dossiers chargés pour les agrégats (stats, cockpit, anti-fraude).
ANALYSIS_MAX_CLAIMS=100000

# --- Paramètres conventionnels et métier (valeurs par défaut du code) ---
# ELIGIBILITY_GRID_VERSION=v2025.12
# ELIGIBILITY_MAX_AMOUNT_DA=300000
# ELIGIBILITY_RECOURS_MAX_MONTHS=6
# MATCHING_AUTO_THRESHOLD=80
# MATCHING_CONFIRM_THRESHOLD=50
# RECOURS_SILENCE_DAYS=30
# RECOURS_OPPOSITION_DAYS=15
# Balayage périodique des délais de recours (minutes, 0 = désactivé, max 1440).
RECOURS_SWEEP_INTERVAL_MINUTES=60
# Plafond d'une pénalité prononcée par la commission (DA, 2 décimales) ;
# défaut : ELIGIBILITY_MAX_AMOUNT_DA.
# COMMISSION_PENALTY_MAX_DA=300000
# Antériorité maximale de la date de réception d'un courrier d'adhésion/retrait
# (jours, 0 à 366 ; 30 en attendant la décision UAR, SEC-47).
MEMBERSHIP_RECEIVED_MAX_AGE_DAYS=30
# FRAUD_RECURRENCE_WINDOW_DAYS=90
# FRAUD_TRANSMISSION_LATE_DAYS=15
# FRAUD_VELOCITY_SAME_DAY_THRESHOLD=3

# --- Paperless (GED / OCR) ---
PAPERLESS_BASE_URL=http://localhost:8010
PAPERLESS_TOKEN=changeme
PAPERLESS_ENABLED=false

# --- CORS (frontend, HTTP et WebSocket) ---
# Origine(s) exacte(s), séparées par des virgules. "*" est refusé.
CORS_ORIGIN=http://localhost:3000

# --- Exposition (limitation de débit, proxy, documentation, journaux) ---
# Limitation de débit globale par adresse IP cliente (défaut 300 requêtes / 60 s).
# Désactivable hors production uniquement (désactivée par défaut sous Jest).
# THROTTLE_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
# Limites plus strictes par route (requêtes / fenêtre en secondes), mêmes
# interrupteurs que la limite globale (voir src/common/throttle/route-throttle.ts) :
#   import de déclarations (POST /claims/import)
THROTTLE_IMPORT_LIMIT=10
THROTTLE_IMPORT_TTL_SECONDS=60
#   dépôt de pièces (POST /documents/upload)
THROTTLE_UPLOAD_LIMIT=30
THROTTLE_UPLOAD_TTL_SECONDS=60
#   vérification complète du journal scellé (GET /ledger/verify)
THROTTLE_LEDGER_VERIFY_LIMIT=6
THROTTLE_LEDGER_VERIFY_TTL_SECONDS=60
#   administration : utilisateurs, matrice des droits, grille tarifaire
THROTTLE_ADMIN_LIMIT=30
THROTTLE_ADMIN_TTL_SECONDS=60
# Nombre de reverse proxies de confiance devant l'API (X-Forwarded-For). 0 = aucun.
TRUST_PROXY_HOPS=0
# Swagger (/api/docs) : actif par défaut hors production, désactivé en production.
# SWAGGER_ENABLED=true
# Journaux JSON (une entrée par ligne) : défaut true en production.
# LOG_JSON=false

# --- Commandes destructrices (migration:down, seeder) ---
# Refusées en production sauf ALLOW_PRODUCTION_DESTRUCTIVE=true posé pour
# CETTE exécution uniquement (jamais dans un fichier d'environnement permanent).
# ALLOW_PRODUCTION_DESTRUCTIVE=false

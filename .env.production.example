# === IDA Place backend - variables d'environnement (PRODUCTION) ===
# Modèle SANS AUCUNE VALEUR SECRÈTE : chaque <...> est à fournir par le coffre
# de secrets de l'environnement (jamais dans le dépôt ni dans l'image).
# Le démarrage échoue si une variable obligatoire manque, vaut une valeur
# d'exemple publique, ou si une option dangereuse est activée
# (src/common/config/env.validation.ts). Aucun mode de développement :
# AUTH_PROVIDER=dev, x-dev-user, repli mémoire et entrées de démonstration
# sont tous refusés ou désactivés quand NODE_ENV=production.

NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# --- PostgreSQL : rôle APPLICATIF (SELECT/INSERT sur le journal scellé, voir
# Migration20261020000100_LedgerIntegrity) ; les migrations s'exécutent dans
# un job séparé avec le rôle de migration. ---
DB_HOST=<hôte privé PostgreSQL>
DB_PORT=5432
DB_NAME=ida_place
DB_USER=ida_place_app
DB_PASSWORD=<secret>
DB_SSL=true
DB_SSL_CA=/run/secrets/postgres-ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Redis (si activé : mot de passe obligatoire, TLS recommandé) ---
REDIS_ENABLED=false
# REDIS_URL=rediss://:<secret>@<hôte privé redis>:6380

# --- Authentification : Keycloak uniquement ---
AUTH_PROVIDER=keycloak
KEYCLOAK_BASE_URL=https://<hôte keycloak>
KEYCLOAK_REALM=ida-place
KEYCLOAK_CLIENT_ID=ida-place-api
KEYCLOAK_ALLOWED_CLIENTS=ida-place-web

# --- Journal scellé : clé HMAC (≥ 32 caractères), conservée hors base ---
LEDGER_HMAC_KEY=<secret>

# --- Stockage documentaire ---
S3_ENABLED=true
S3_ENDPOINT=https://<hôte stockage objet>
S3_BUCKET=ida-place-docs
S3_ACCESS_KEY=<secret>
S3_SECRET_KEY=<secret>

# --- Exposition Internet ---
# Origine(s) exacte(s) du frontend, en https (jamais "*").
CORS_ORIGIN=https://<domaine du frontend>
# Reverse proxy TLS devant l'API (nombre de sauts de confiance pour X-Forwarded-For).
TRUST_PROXY_HOPS=1
# Limitation de débit (ne peut pas être désactivée en production).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
# Swagger désactivé (laisser absent ; SWAGGER_ENABLED=true l'exposerait publiquement).
LOG_JSON=true

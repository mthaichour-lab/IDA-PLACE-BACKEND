# === IDA Place backend - variables d'environnement (PRODUCTION) ===
# Modèle SANS AUCUNE VALEUR SECRÈTE : chaque <...> est à fournir par le coffre
# de secrets de l'environnement (jamais dans le dépôt ni dans l'image).
# Le démarrage échoue si une variable obligatoire manque, vaut une valeur
# d'exemple publique, ou si une option dangereuse est activée
# (src/common/config/env.validation.ts). Aucun mode de développement :
# AUTH_PROVIDER=dev, x-dev-user, repli mémoire et entrées de démonstration
# sont tous refusés ou désactivés quand NODE_ENV=production.

NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# --- PostgreSQL : rôle APPLICATIF (SELECT/INSERT sur le journal scellé, voir
# Migration20261020000100_LedgerIntegrity) ; les migrations s'exécutent dans
# un job séparé avec le rôle de migration. ---
DB_HOST=<hôte privé PostgreSQL>
DB_PORT=5432
DB_NAME=ida_place
DB_USER=ida_place_app
DB_PASSWORD=<secret>
DB_SSL=true
DB_SSL_CA=/run/secrets/postgres-ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Redis (si activé : mot de passe obligatoire, TLS recommandé) ---
REDIS_ENABLED=false
# REDIS_URL=rediss://:<secret>@<hôte privé redis>:6380

# --- Authentification : Keycloak uniquement ---
AUTH_PROVIDER=keycloak
KEYCLOAK_BASE_URL=https://<hôte keycloak>
KEYCLOAK_REALM=ida-place
KEYCLOAK_CLIENT_ID=ida-place-api
KEYCLOAK_ALLOWED_CLIENTS=ida-place-web

# --- Journal scellé : clé HMAC (≥ 32 caractères), conservée hors base ---
LEDGER_HMAC_KEY=<secret>

# --- Stockage documentaire ---
S3_ENABLED=true
S3_ENDPOINT=https://<hôte stockage objet>
S3_BUCKET=ida-place-docs
S3_REGION=<région du stockage objet>
S3_ACCESS_KEY=<secret>
S3_SECRET_KEY=<secret>
# Chiffrement côté serveur obligatoire (none refusé en production) : AES256 ou aws:kms.
S3_SSE=AES256
# S3_SSE_KMS_KEY_ID=<identifiant de la clé KMS, si S3_SSE=aws:kms>
# Aucun secret de signature applicatif : S3 signe ses URL pré-signées.
# Antivirus des pièces (recommandé) : démon ClamAV sur le réseau privé.
ANTIVIRUS_MODE=clamd
CLAMD_HOST=<hôte privé clamd>
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=15000

# --- Experts : clé de chiffrement des RIB (32 octets base64, coffre de secrets) ---
# Absente : toute saisie de RIB est refusée. Voir docs/DEPLOIEMENT.md
# (rechiffrement des RIB hérités).
EXPERT_RIB_KEY=<secret>

# --- Imports et analyses (bornes) ---
IMPORT_MAX_ROWS=5000
IMPORT_XLSX_MAX_UNCOMPRESSED_BYTES=52428800
IMPORT_XLSX_MAX_COMPRESSION_RATIO=100
IMPORT_XLSX_MAX_ENTRIES=500
ANALYSIS_MAX_CLAIMS=100000

# --- Paramètres conventionnels (valeurs validées par l'UAR ; défauts du code si absents) ---
# ELIGIBILITY_GRID_VERSION=<version de la grille>
# ELIGIBILITY_MAX_AMOUNT_DA=<plafond Art. 4>
# ELIGIBILITY_RECOURS_MAX_MONTHS=<délai Art. 19>
# MATCHING_AUTO_THRESHOLD=<seuil>
# MATCHING_CONFIRM_THRESHOLD=<seuil>
# RECOURS_SILENCE_DAYS=<délai>
# RECOURS_OPPOSITION_DAYS=<délai>
RECOURS_SWEEP_INTERVAL_MINUTES=60
# COMMISSION_PENALTY_MAX_DA=<plafond des pénalités ; défaut ELIGIBILITY_MAX_AMOUNT_DA>
MEMBERSHIP_RECEIVED_MAX_AGE_DAYS=<plafond d'antériorité, en jours (décision UAR SEC-47)>
# FRAUD_RECURRENCE_WINDOW_DAYS / FRAUD_TRANSMISSION_LATE_DAYS / FRAUD_VELOCITY_SAME_DAY_THRESHOLD

# --- Exposition Internet ---
# Origine(s) exacte(s) du frontend, en https (jamais "*").
CORS_ORIGIN=https://<domaine du frontend>
# Reverse proxy TLS devant l'API (nombre de sauts de confiance pour X-Forwarded-For).
TRUST_PROXY_HOPS=1
# Limitation de débit (ne peut pas être désactivée en production).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
# Limites strictes par route (défauts du code indiqués).
THROTTLE_IMPORT_LIMIT=10
THROTTLE_IMPORT_TTL_SECONDS=60
THROTTLE_UPLOAD_LIMIT=30
THROTTLE_UPLOAD_TTL_SECONDS=60
THROTTLE_LEDGER_VERIFY_LIMIT=6
THROTTLE_LEDGER_VERIFY_TTL_SECONDS=60
THROTTLE_ADMIN_LIMIT=30
THROTTLE_ADMIN_TTL_SECONDS=60
# Swagger désactivé (laisser absent ; SWAGGER_ENABLED=true l'exposerait publiquement).
LOG_JSON=true
